<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#6600E5FF" android:dashWidth="6dp" android:dashGap="5dp" />
        </shape>
    </item>
    <item android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#AA00E5FF" />
        </shape>
    </item>
</layer-list>
